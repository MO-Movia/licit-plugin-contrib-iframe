{
  "name": "@modusoperandi/licit-iframe",
  "version": "1.0.0",
  "type": "module",
  "subversion": "1",
  "description": "IFrame plugin built with React and ProseMirror",
  "main": "index.js",
  "types": "index.d.ts",
  "style": "styles.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MO-Movia/licit-plugin-contrib-iframe.git"
  },
  "scripts": {
    "lint:ts": "eslint src --ext .ts --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "npm run lint:css & npm run lint:ts",
    "test": "jest",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "ci:build": "tsc --build && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json dist",
    "ci:bom": "cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "debug": "node --debug-brk --inspect ./node_modules/.bin/jest -i",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "peerDependencies": {
    "@modusoperandi/licit-ui-commands": "^1.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^3.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.1.0",
    "@types/react": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.5.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.31.10",
    "husky": "^9.0.10",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.2.0",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-prettier": "^5.0.0",
    "typescript": "5.8.3",
    "ts-jest": "^29.0.7",
    "ts-node": "^10.2.1"
  },
  "overrides": {
    "libxmljs2": "^1.0.0"
  },
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix"
    ],
    "!(*test|*.setup).ts": [
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}